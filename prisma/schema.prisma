generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("PRISMA_DATABASE_URL")
  directUrl = env("POSTGRES_URL")
}

model Tenant {
  id              String   @id @default(cuid())
  name            String                          // e.g. "GWM Dev"
  tunnelSubdomain String   @unique                // e.g. "gwmdev" → gwmdev-agent.bespoxai.com
  bcInstance      String   @default("GWM_Dev")   // BC instance name in URL path
  bcCompany       String   @default("GWM")        // BC company name for OData
  apiKey          String                          // X-BespoxAI-Key header value
  active          Boolean  @default(true)
  entityConfig    Json?
  tunnelId        String?
  country         String   @default("NZ")   // ISO country code for CFO/tax context
  navProduct      String?                    // "BC" | "NAV" | "unsure"
  navVersion      String?                    // e.g. "Business Central 2024 Wave 2 (BC25)"
  lastCU          String?                    // e.g. "CU3" — free text
  bcPort          Int      @default(8048)    // BC OData port (injected into installer)
  agentPort       Int      @default(8080)    // BCAgent listening port (injected into installer)
  navDatabaseServer   String?  @default("localhost") // NAV/BC14 SQL Server host (injected into installer v2.3+)
  navDatabaseName     String?                        // NAV/BC14 SQL database name
  navServerInstance   String?                        // NAV server instance name (optional)
  // ── Test environment (same server, different DB/port) ─────────────────────
  testNavDatabaseServer  String?                     // defaults to navDatabaseServer if blank
  testNavDatabaseName    String?                     // test NAV database name
  testNavServerInstance  String?                     // test NAV server instance
  testBcPort             Int?                        // test BC OData port
  testBcInstance         String?                     // test BC instance name
  testBcCompany          String?                     // test BC company name
  testAgentPort          Int?                        // test BCAgent listening port
  githubOrg            String?                    // GitHub org for customer repos (defaults to NavSolutionsNZ)
  githubRepo           String?                    // GitHub repo name e.g. bespoxai-acme
  testServerSeparate   Boolean  @default(false)   // true = separate Windows Server for test env
  testAgentUrl         String?                    // URL of BCAgent on separate test server
  testTunnelToken      String?                    // Cloudflare tunnel token for test server
  tier                 String   @default("trial") // "free" | "trial" | "assistant" | "manager" | "executive"
  trialEndsAt          DateTime?                  // null = no expiry
  stripeCustomerId     String?                    // Stripe customer ID
  stripeSubscriptionId String?                    // active Stripe subscription ID
  stripePriceId        String?                    // current price ID (to identify plan + interval)
  subscriptionStatus   String?  @default("inactive") // active | inactive | past_due | cancelled | trialing
  cancelledAt          DateTime?
  cancellationReason   String?   // billing_error | cancellation_requested | payment_disputed
  cancellationFeedback String?   // feedback + comment from Stripe portal survey
  paymentTermsKey      String   @default("terms1") // terms1 | terms2 | terms3
  createdAt            DateTime @default(now())
  updatedAt       DateTime @updatedAt
  users               User[]
  queryLogs           QueryLog[]
  requirements        Requirement[]
  migrationEnquiries  MigrationEnquiry[]
  objectFiles         TenantObjectFile[]
  aiUsageLogs         AiUsageLog[]
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?                          // kept for backward compat — full display name
  firstName     String?
  lastName      String?
  preferredName String?                          // address by this if set, else firstName
  password      String                           // bcrypt hashed
  role          String    @default("user")       // "superadmin" | "tenant_admin" | "user" | "developer"
  persona       String?                          // "cfo" | "finance" | "it" | "other"
  onboardingDone Boolean  @default(false)
  active        Boolean   @default(true)
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  queryLogs     QueryLog[]
  requirements  Requirement[]
  assignedRequirements Requirement[] @relation("RequirementDeveloper")
  migrationEnquiries MigrationEnquiry[]
  uploadedObjects    TenantObjectFile[]
}

model SignupRequest {
  id            String   @id @default(cuid())
  companyName   String
  country       String   @default("NZ")
  bcVersion     String   @default("BC25")
  email         String
  verifyToken   String   @unique
  verifiedAt    DateTime?
  activatedAt   DateTime?                        // set when admin sends password
  createdAt     DateTime @default(now())
}

// --- NextAuth required models ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model QueryLog {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  question    String
  answer      String   @db.Text
  displayHint String?
  data        Json?
  entity      String?
  recordCount Int?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
}

model Requirement {
  id              String    @id @default(cuid())
  tenantId        String
  userId          String
  title           String
  description     String    @db.Text
  bcArea          String    // Sales | Purchase | Finance | Inventory | Manufacturing | Project | HR | Other
  priority        String    // nice_to_have | important | critical
  aiSpec          String?   @db.Text  // JSON: userStory, acceptanceCriteria, bcObjects, complexity, estimatedDays, assumptions, questions
  status          String    @default("draft") // draft | submitted | needs_clarification | in_review | quoted | quote_rejected | deposit_required | deposit_paid | in_development | complete_pending_payment | fully_paid | rejected
  quote           Decimal?  @db.Decimal(10, 2)
  quoteApprovedAt DateTime?
  depositAmount   Decimal?  @db.Decimal(10, 2)  // 20% of quote, auto-calculated on acceptance
  depositPaidAt   DateTime?
  balancePaidAt   DateTime?
  consultantNote  String?   @db.Text
  adminQuestions  String?   @db.Text  // Most recent admin questions (current round)
  customerAnswers String?   @db.Text  // JSON array [{q, a}] — answers to AI clarifying questions
  adminQALog      String?   @db.Text  // JSON array [{round, questions, answers, askedAt, answeredAt}]
  quoteRejectedAt      DateTime?
  quoteRejectionReason String?  @db.Text

  // ── Deployment & UAT tracking ──────────────────────────────────────────────
  testDeploySnapshotId  String?           // BCAgent snapshotId deployed to test
  testDeployedAt        DateTime?         // when deployed to test env
  githubBranch          String?           // GitHub branch for this requirement e.g. req/abc123-shopify
  assignedDeveloperId   String?           // nullable — developer assigned to this req (null = visible to all devs)
  assignedDeveloper     User?             @relation("RequirementDeveloper", fields: [assignedDeveloperId], references: [id], onDelete: SetNull)
  uatApprovedAt         DateTime?         // customer signed off UAT
  uatApprovedById       String?           // userId who approved
  uatRejectedAt         DateTime?         // customer rejected UAT
  uatRejectedById       String?           // userId who rejected
  uatRejectionReason    String?  @db.Text // customer's rejection text
  uatRejectionAnalysis  Json?             // {isScopeCreep, explanation, suggestedAmendment}
  devPlan              String?  @db.Text  // JSON: internal superadmin-only development plan
  depositStripeSessionId  String?          // Stripe Checkout Session ID for deposit payment
  depositBypassed         Boolean @default(false)  // superadmin can bypass deposit requirement
  fullPaymentRequested    Boolean @default(false)  // customer requested to pay in full upfront
  fullPaymentApproved     Boolean @default(false)  // superadmin approved full upfront payment
  balanceStripeSessionId  String?          // Stripe Checkout Session ID for balance payment
  poNumber                String?          // Customer PO number / reference, shown on invoice
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Feasibility check fields — populated by POST /api/requirements/[id]/feasibility
  feasibility          String?            // 'cfo_assistant' | 'development' | 'infeasible'
  feasibilityNotes     String?   @db.Text // Plain-English explanation from BespoxAI
  feasibilityCostRange String?            // 'NZD 2-5k' | '5-15k' | '15k+' — development only
  feasibilityCheckedAt DateTime?          // Timestamp of most recent check

  // Senior developer review fee — $249 NZD (credited against dev if they proceed)
  reviewPaidAt          DateTime?          // Set by webhook when $249 payment confirmed
  reviewStripeSessionId String?            // Stripe Checkout Session ID for review payment
  reviewBypassed        Boolean  @default(false) // Superadmin can waive the fee
  reviewIncluded        Boolean  @default(false) // Covered by Manager/Executive monthly allowance
  reviewSubmittedAt     DateTime?          // When review was submitted (any payment method)

  // ── Production deployment ─────────────────────────────────────────────────
  prodApprovalSentAt   DateTime?          // when go-live doc was sent to customer
  prodGoLiveDoc        String?  @db.Text  // AI-generated go-live summary sent to customer
  prodApprovedAt       DateTime?          // when customer approved go-live
  prodApprovedById     String?            // userId who approved
  prodDeployedAt       DateTime?          // when production deployment completed
  prodDeploySnapshotId String?            // BCAgent snapshot ID used for prod deploy

  // ── Addendum (child requirements linked to a parent) ──────────────────────
  parentId  String?           // set on addenda; null on top-level requirements
  parent    Requirement?      @relation("RequirementAddenda", fields: [parentId], references: [id], onDelete: SetNull)
  addenda   Requirement[]     @relation("RequirementAddenda")

  tenant  Tenant             @relation(fields: [tenantId], references: [id])
  user    User               @relation(fields: [userId], references: [id])
  objects TenantObjectFile[]
  aiUsageLogs AiUsageLog[]
}

model MigrationEnquiry {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  contactName String?
  phone       String
  version     String
  users       String
  urgency     String?
  notes       String?  @db.Text
  status      String   @default("new")  // new | contacted | quoted | closed
  depositStripeSessionId String?        // Stripe Checkout Session ID for $500 deposit
  depositPaidAt          DateTime?      // set when deposit confirmed via webhook
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
}

model TenantObjectFile {
  id            String    @id @default(cuid())
  tenantId      String
  requirementId String?
  filename      String
  objectType    String    @default("Unknown")
  objectId      Int?
  objectName    String
  language      String    @default("AL")
  summary       Json      @default("{}")
  content       String?   @db.Text          // Full C/AL source or BC metadata text — stored after client-side split
  parseError    Boolean   @default(false)
  uploadedAt    DateTime  @default(now())
  uploadedById  String

  tenant      Tenant       @relation(fields: [tenantId],      references: [id])
  requirement Requirement? @relation(fields: [requirementId], references: [id])
  uploadedBy  User         @relation(fields: [uploadedById],  references: [id])

  @@index([tenantId])
  @@index([requirementId])
}

model AiUsageLog {
  id            String   @id @default(cuid())
  tenantId      String
  requirementId String?
  feature       String   // dev_assistant | spec_gen | dev_plan | feasibility | cfo_query
  model         String
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  createdAt     DateTime @default(now())

  tenant      Tenant       @relation(fields: [tenantId],      references: [id])
  requirement Requirement? @relation(fields: [requirementId], references: [id])

  @@index([tenantId])
  @@index([createdAt])
}

model AiConfig {
  id             String   @id @default("default")
  provider       String   @default("anthropic")
  model          String   @default("claude-sonnet-4-5")
  maxTokens      Int      @default(1000)
  temperature    Float    @default(0.4)
  devAssistant   Boolean  @default(true)
  specGeneration Boolean  @default(true)
  devPlan        Boolean  @default(true)
  feasibility    Boolean  @default(true)
  cfoChatQuery   Boolean  @default(true)
  updatedAt      DateTime @updatedAt
  updatedBy      String?
}

model BusinessConfig {
  id              String   @id @default("default")
  companyName     String   @default("Nav Solutions NZ")
  gstNumber       String?
  email           String   @default("auckland@bespoxai.com")
  phone           String?
  website         String   @default("bespoxai.com")
  address         String?
  bankName        String?
  bankAccount     String?
  bankAccountName String?
  invoiceFooter   String   @default("Thank you for choosing BespoxAI")
  terms1Label     String   @default("Standard")
  terms1Text      String   @default("20% deposit on acceptance; 80% on delivery")
  terms2Label     String   @default("Deposit + Monthly")
  terms2Text      String   @default("20% deposit on acceptance; balance due 20th of following month")
  terms3Label     String   @default("Account")
  terms3Text      String   @default("Full amount due 20th of the following month")
  updatedAt       DateTime @updatedAt
  updatedBy       String?
}
