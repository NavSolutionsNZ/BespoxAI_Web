# Copy to .env.e2e and fill in. Loaded via: npx dotenv -e .env.e2e -- npx playwright test
# (or export these in your shell before running)

# ── URLs ─────────────────────────────────────────────────────────────────────
MAIN_URL=https://bespoxai.com
PARTNER_URL=https://partners.bespoxai.com

# ── Smoke tier: Demo1 tenant user (bc22 Docker container) ──────────────────
# Must have finished first-login setup (no onboarding / password change).
DEMO_EMAIL=
DEMO_PASSWORD=
# 1 = also check the BC agent is connected and a CFO question gets an answer.
# Leave 0 when the bc22 container is off (424s from the agent are then ignored).
E2E_EXPECT_BC=0

# ── Partner deliverer account (partner_admin) ───────────────────────────────
PARTNER_EMAIL=partner@testpartner.com
PARTNER_PASSWORD=
# Client tenant to test against (e.g. Acme Distribution Ltd)
PARTNER_TENANT_ID=cro7hmob054poa056gtgh1540

# ── Customer account (tenant_admin on the test tenant) ──────────────────────
CUSTOMER_EMAIL=client@acmedist.com
CUSTOMER_PASSWORD=

# ── How far to advance the partner pipeline ─────────────────────────────────
# safe = stop after Issue Quote (no payment/irreversible marks)
# full = walk the entire status chain
ADVANCE=safe
